{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://day-trader-api.onrender.com/api/:path*" },
    { "source": "/ws", "destination": "https://day-trader-api.onrender.com/ws" }
  ],
  "env": {
    "VITE_API_URL": "https://day-trader-api.onrender.com",
    "VITE_WS_URL": "wss://day-trader-api.onrender.com"
  }
}
