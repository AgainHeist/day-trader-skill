# Database
DATABASE_URL=postgresql://user:password@localhost:5432/daytrader
# For local dev with SQLite, leave empty or use:
# DATABASE_URL=sqlite:///./trader.db

# Redis (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Secrets — never commit real values
SESSION_SECRET=change-me-to-a-long-random-secret
ENCRYPTION_KEY=change-me-to-32-chars-minimum!!
SEC_USER_AGENT=Your Name you@example.com

# AI Provider (optional, OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://day-trader-web.vercel.app

# Frontend (Vite — public, not secret)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
